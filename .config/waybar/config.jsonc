{
    "layer": "top",
    "modules-left": ["clock", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/weather", "group/wifibt", "group/sys", "hyprland/language",  "battery", "custom/notification"],
    "hyprland/window": {
        "max-length": 50,
	"rewrite": {
	    "": "no windows"
	}
    },
    "hyprland/workspaces": {
	"format": "{icon}",
	"on-click": "activate",
        "format-icons": {
	    "1": "1",
	    "2": "2",
	    "3": "3",
	},
	"persistent-workspaces": {
	    "*": 5
	},
	"sort-by-number": true
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format-alt": "{:%a, %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
           "mode": "month",
           "format": {
               "today": "<b><u>{}</u></b>"
           },
           "on-scroll": 1
        },
        "actions": {
           "on-click-right": "mode",
           "on-scroll-up": "shift_up",
           "on-scroll-down": "shift_down"
        }
    },
    "bluetooth": {
	// "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
	"format": ": {status}",
	"format-disabled": "", // an empty format will hide the module
	"format-connected": ": {num_connections} connected",
	"tooltip-format": "{controller_alias}\t{controller_address}",
	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "group/wifibt":{
          "orientation": "inherit",
          "drawer": {
           "transition-duration": 500,
           "children-class": "not-power",
           "transition-left-to-right": false,
           "click-to-reveal": true
         },
         "modules": [
           "custom/wifibt",
           "bluetooth",
           "network"
         ]
    }, 
    "custom/wifibt":{
         "format" : " 󰤨"
    },
    "network": {
         "format": "{ifname}",
         "format-wifi": "{essid} ({signalStrength}%) ",
         "format-ethernet": "{ipaddr}/{cidr} 󰊗",
         "format-disconnected": "", //An empty format will hide the module.
         "tooltip-format": "{ifname} via {gwaddr} 󰊗",
         "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
         "tooltip-format-ethernet": "{ifname} ",
         "tooltip-format-disconnected": "Disconnected",
         "max-length": 50
    },
    "custom/notification": {
         "tooltip": false,
         "format": "{icon}",
         "format-icons": {
           "notification": "<span foreground='red'><sup></sup></span>",
           "none": "",
           "dnd-notification": "<span foreground='red'><sup></sup></span>",
           "dnd-none": "",
           "inhibited-notification": "<span foreground='red'><sup></sup></span>",
           "inhibited-none": "",
           "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
           "dnd-inhibited-none": ""
         },
         "return-type": "json",
         "exec-if": "which swaync-client",
         "exec": "swaync-client -swb",
         "on-click": "swaync-client -t -sw",
         "on-click-right": "swaync-client -d -sw",
         "escape": true
    },
    "custom/weather": {
         "exec": "${HOME}/.config/waybar/scripts/get_weather.sh Moscow",
         "return-type": "json",
         "format": "{}",
         "tooltip": true,
         "interval": 3600
    },
    "group/sys": {
         "orientation": "inherit",
         "drawer": {
           "transition-duration": 500,
           "children-class": "not-power",
           "transition-left-to-right": false,
           "click-to-reveal": true
         },
         "modules": [
           "custom/sys",
           "cpu",
           "disk",
           "memory",
           "privacy"
         ]
    },
    "custom/sys": {
         "format": ""
    },
    "cpu": {
         "interval": 2,
         "format": "",
         "tooltip": true,
         "tooltip-format": "CPU: {usage}%"
    },
    "disk": {
         "path": "/",
         "interval": 60,
         "format": "",
         "tooltip": true,
         "tooltip-format": "{used}/{total} ({percentage_used}% used)"
    },
    "memory": {
         "interval": 2,
         "format": "",
         "tooltip": true,
         "tooltip-format": "Mem: {percentage}%, Swap: {swapPercentage}%"
    },
    "privacy": {
         "format": "󰦝",
         "tooltip": true
    },
    "hyprland/language": {
         "format": "{}",
         "format-en": "ENG",
         "format-ru": "RUS",
         "keyboard-name": "at-translated-set-2-keyboard"
    }
}
