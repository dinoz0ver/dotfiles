{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
	"source": "~/dinosmoking_alpha.ans", 
        "padding": {"right": 2},
    },
    "display": {
        "separator": " ",
	"color": {
		"title": "#ffc0cb",
		"keys": "#ffc0cb",
		"output": "#ffc0cb",
		"separator": "#ffc0cb",
	},
    },
    "modules": [
        "break",
	{
            "type": "title",
            "keyWidth": 10, 
        },
        "break",
        {
            "type": "os",
            "key": " ",
        },
        {
            "type": "kernel",
            "key": " ",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",  
        },
        {
            "type": "shell",
            "key": " ", 
        },
        {
            "type": "terminal",
            "key": " ", 
        },
        {
            "type": "wm",
            "key": " ", 
        },
        {
            "type": "uptime",
            "key": " ", 
        },
        {
            "type": "media",
            "key": "󰝚 ", 
        },
	"break", "break",
	{ //this prevents all text in console being pink
	    "type": "custom",
	    "format": "{#}",
	},
        "break",
        "break",
        "break",
    ]
}
